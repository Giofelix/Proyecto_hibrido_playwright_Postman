{
  "name": "proyecto-automatizacion-hibrida",
  "version": "1.0.0",
  "description": "Proyecto de automatización híbrido",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); for (const dir of ['reports', 'allure-results']) { if (fs.existsSync(dir)) fs.rmSync(dir, { recursive: true, force: true }); } fs.mkdirSync('reports/api-report', { recursive: true }); fs.mkdirSync('reports/ui-report', { recursive: true }); fs.mkdirSync('allure-results', { recursive: true }); console.log('✅ Carpetas de reportes listas');\"",
    "api:test": "newman run \"api/collections/API_Automation_Project_collection.json\" -g \"api/environments/workspace.postman_globals.json\" -r htmlextra,allure --reporter-htmlextra-export \"reports/api-report/api-report.html\" --reporter-allure-results-dir \"allure-results\" --disable-unicode --silent",
    "ui:test": "npx playwright test --output=reports/ui-report",
    "ui:report": "npx playwright show-report reports/ui-report",
    "allure:generate": "allure generate allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "test:all": "npm-run-all clean api:test ui:test allure:generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.12.2",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "newman": "^6.2.2",
    "newman-reporter-allure": "^3.12.2",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
